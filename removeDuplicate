import java.util.*;
class Main {
    public static void main(String[] args) {
       int arr [] = {1,2,2,3,4,5,6};
       int n =  arr.length;
       int res [] = new int[arr.length];
       
       int k = 0;
       
       for(int i=0;i<n;i++){
           boolean isDuplicate = false;
           for(int j=0;j<k;j++){
               if(arr[i] == arr[j]){
                  isDuplicate = true;
                  break;
               }
           }
           
           if(!isDuplicate){
               res[i] = arr[i];
               k++;
           }
       }
       
    //   for(int i = 0; i < k; i++){
    //         System.out.print(res[i] + " ");
    //     }
    
    System.out.println(Arrays.toString(res));
    }
}
